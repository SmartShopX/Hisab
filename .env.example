# SmartShopX Environment Configuration
# Never commit production secrets to this file

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/smartshopx
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=
SQL_DB_NAME=smartshopx
DB_SSL=false
DB_POOL_MAX=10

# Central Authority Authentication
JWT_SECRET=replace_with_a_secure_random_production_secret_key_smartshopx

# Frontend API Configuration
VITE_API_BASE_URL=/api/v1

# AI Studio / Gemini API Key (Server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# AI Studio Rate Limiting
AI_RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_MAX_REQUESTS=30

